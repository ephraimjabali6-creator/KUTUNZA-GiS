# Kutunza — swap these to the client's accounts without changing application code.
# Keep secrets in .env.local (local) or the host's env UI (Vercel / Railway / etc).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys + Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend). FROM must be a verified domain on the client's Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kutunza <giving@kutunza.org>
NOTIFY_EMAIL=giving@kutunza.org

# Optional PostgreSQL. If empty, donations and contact logs stay in memory (dev only).
DATABASE_URL=

# Local / preview only. Never enable in production.
DEMO_PAYMENTS=true
